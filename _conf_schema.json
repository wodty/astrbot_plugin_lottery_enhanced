{
    "prize_config": {
        "description": "默认奖品配置",
        "hint": "开启抽奖时不会自动加载这些奖品，管理员需通过「添加奖品」命令手动设置。此配置仅作为展示和未来扩展使用。",
        "type": "object",
        "items": {
            "first": {
                "description": "一等奖",
                "type": "object",
                "items": {
                    "name": {
                        "description": "奖品名称",
                        "type": "string",
                        "default": "U盘"
                    },
                    "count": {
                        "description": "奖品数量",
                        "type": "int",
                        "slider": {
                            "min": 0,
                            "max": 50,
                            "step": 1
                        },
                        "default": 3
                    },
                    "color": {
                        "description": "转盘对应颜色",
                        "type": "string",
                        "default": "#D91E1C"
                    }
                }
            },
            "second": {
                "description": "二等奖",
                "type": "object",
                "items": {
                    "name": {
                        "description": "奖品名称",
                        "type": "string",
                        "default": "小风扇"
                    },
                    "count": {
                        "description": "奖品数量",
                        "type": "int",
                        "slider": {
                            "min": 0,
                            "max": 100,
                            "step": 1
                        },
                        "default": 5
                    },
                    "color": {
                        "description": "转盘对应颜色",
                        "type": "string",
                        "default": "#007CC2"
                    }
                }
            },
            "third": {
                "description": "三等奖",
                "type": "object",
                "items": {
                    "name": {
                        "description": "奖品名称",
                        "type": "string",
                        "default": "钥匙扣"
                    },
                    "count": {
                        "description": "奖品数量",
                        "type": "int",
                        "slider": {
                            "min": 0,
                            "max": 100,
                            "step": 1
                        },
                        "default": 10
                    },
                    "color": {
                        "description": "转盘对应颜色",
                        "type": "string",
                        "default": "#DD167B"
                    }
                }
            }
        }
    },
    "lottery_settings": {
        "description": "抽奖活动默认设置",
        "hint": "开启抽奖时，如果未指定参数则使用此默认值",
        "type": "object",
        "items": {
            "default_max_participants": {
                "description": "默认满人开奖人数（0 = 手动开奖）",
                "type": "int",
                "slider": {
                    "min": 0,
                    "max": 500,
                    "step": 1
                },
                "default": 0
            },
            "default_min_level": {
                "description": "默认最低群等级（0 = 不限）",
                "type": "int",
                "slider": {
                    "min": 0,
                    "max": 100,
                    "step": 1
                },
                "default": 0
            },
            "default_min_role": {
                "description": "默认最低身份要求",
                "type": "string",
                "default": "member",
                "options": [
                    {
                        "label": "不限",
                        "value": "member"
                    },
                    {
                        "label": "管理员",
                        "value": "admin"
                    },
                    {
                        "label": "群主",
                        "value": "owner"
                    }
                ]
            }
        }
    }
}
